{
  "uid": "paperless-observability",
  "title": "Paperless Observability",
  "tags": [
    "paperless"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Traces",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Recent traces",
      "description": "Select a trace ID to inspect its spans. Startup logs and outbox dispatch can belong to separate traces.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "query": "{ resource.service.name =~ \"paperless.*\" && (kind = server || kind = producer || kind = consumer) }",
          "queryType": "traceql",
          "tableType": "traces",
          "limit": 20,
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Trace ID|traceID|traceId)$"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Inspect trace",
                    "url": "?var-traceId=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Start time",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "traces",
      "title": "Selected trace",
      "description": "Set Trace ID above to inspect one trace. RabbitMQ producer and consumer spans propagate W3C context. The database outbox does not retain the original upload HTTP context.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "$traceId",
          "filters": []
        }
      ],
      "options": {
        "enableFilter": true,
        "enableSearch": true,
        "showTimes": true,
        "showDuration": true,
        "showViewportName": true
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Application logs",
      "description": "Open trace.id in log details to navigate to Tempo. Only logs emitted inside an active span have a trace ID.",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "query": "*",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "logs",
              "id": "logs",
              "hide": false
            }
          ]
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showCommonLabels": false,
        "enableLogDetails": true
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Worker logs",
      "description": "Open trace.id in log details to navigate to Tempo. Only logs emitted inside an active span have a trace ID.",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch-worker"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "query": "*",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "logs",
              "id": "logs",
              "hide": false
            }
          ]
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showCommonLabels": false,
        "enableLogDetails": true
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "traceId",
        "label": "Trace ID",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Paste a 32-character W3C trace ID or select one from Recent traces."
      }
    ]
  }
}
