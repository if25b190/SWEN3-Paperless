{
  "uid": "paperless-observability",
  "title": "Paperless Observability",
  "tags": ["paperless"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Traces",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Recent traces",
      "description": "Latest traces from the backend and worker. The trace ID is the same value logged as trace_id in the application logs.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 1 },
      "targets": [
        { "refId": "A", "query": "{ resource.service.name =~ \"paperless.*\" }" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "showHeader": true,
        "sortBy": { "displayName": "Timestamp", "desc": true }
      }
    },
    {
      "id": 3,
      "type": "traces",
      "title": "Trace details",
      "description": "Span view of the traces in the selected time range. Narrow the time range to inspect a single request end to end (HTTP request → RabbitMQ dispatch → OCR work).",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 1 },
      "targets": [
        { "refId": "A", "query": "{ resource.service.name =~ \"paperless.*\" }" }
      ],
      "options": {
        "enableFilter": true,
        "enableSearch": true,
        "showTimes": true,
        "showDuration": true,
        "showViewportName": true
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "panels": []
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Application logs",
      "description": "Container logs of every service (paperless-container-logs index). Each application line carries its trace_id (parsed into trace.id) and, for backend requests, the requestId.",
      "datasource": { "type": "elasticsearch", "uid": "elasticsearch" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 11 },
      "targets": [
        { "refId": "A", "query": "*", "index": "paperless-container-logs", "alias": "container logs", "timeField": "@timestamp", "metrics": [{ "type": "logs", "id": "logs", "hide": false }] }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showCommonLabels": false,
        "enableLogDetails": true
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Worker events",
      "description": "Structured OCR events written by the worker (paperless-worker-events index). Events processed within a trace carry the same trace_id.",
      "datasource": { "type": "elasticsearch", "uid": "elasticsearch" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 11 },
      "targets": [
        { "refId": "A", "query": "*", "index": "paperless-worker-events", "alias": "worker events", "timeField": "@timestamp", "metrics": [{ "type": "logs", "id": "logs", "hide": false }] }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showCommonLabels": false,
        "enableLogDetails": true
      }
    }
  ]
}
