meta {
  name: READONLY member can read team document
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/documents/{{teamDocumentId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{memberAccessToken}}
}

tests {
  test("READONLY team member can read the shared team document", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    expect(res.getBody().id).to.equal(bru.getVar("teamDocumentId"));
    expect(res.getBody().owner_id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    expect(res.getBody().owner_id).to.equal(bru.getVar("createdUserId"));
    expect(res.getBody().team_id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    expect(res.getBody().team_id).to.equal(bru.getVar("teamId"));
    expect(res.getBody().document_type.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
  });
}
