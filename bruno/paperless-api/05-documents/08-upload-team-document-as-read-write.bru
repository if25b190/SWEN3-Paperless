meta {
  name: READ_WRITE member uploads team document
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/documents
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{memberAccessToken}}
}

body:multipart-form {
  document: @file(./fixtures/sample.pdf)
  title: {{teamDocumentTitle}}
  document_type_id: {{documentTypeId}}
  team_id: {{teamId}}
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("teamDocumentId", res.getBody().id);
  }
}

tests {
  test("READ_WRITE member uploads a document shared with the team", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    expect(res.getBody().title).to.equal(bru.getVar("teamDocumentTitle"));
    expect(res.getBody().id).to.not.equal(bru.getVar("privateDocumentId"));
    expect(res.getBody().owner_id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    expect(res.getBody().owner_id).to.equal(bru.getVar("createdUserId"));
    expect(res.getBody().document_type.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    expect(res.getBody().document_type.id).to.equal(bru.getVar("documentTypeId"));
    expect(res.getBody().original_filename).to.equal("sample.pdf");
    expect(res.getBody().content_type).to.equal("application/pdf");
    expect(res.getBody().file_size).to.be.a("number");
    expect(res.getBody().status).to.equal("PENDING");
    expect(res.getBody().team_id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    expect(res.getBody().team_id).to.equal(bru.getVar("teamId"));
  });
}
