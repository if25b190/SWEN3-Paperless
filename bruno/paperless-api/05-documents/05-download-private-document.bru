meta {
  name: Private document owner downloads the original file
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/documents/{{privateDocumentId}}/download
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/pdf
}

tests {
  test("private document owner can download the original file", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
