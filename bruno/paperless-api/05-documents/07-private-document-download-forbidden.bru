meta {
  name: Other account cannot download private document
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/documents/{{privateDocumentId}}/download
  body: none
  auth: bearer
}

auth:bearer {
  token: {{memberAccessToken}}
}

tests {
  test("a different account cannot download the private document", function() {
    expect(res.getStatus()).to.equal(404);
  });
}
