meta {
  name: List documents
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/documents?page=0&size=10&sort=created_at,desc&document_type_id={{documentTypeId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("admin can list documents filtered by the created document type", function() {
    expect(res.getStatus()).to.equal(200);
    res.getBody().items.forEach((document) => {
      expect(document.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
      expect(document.owner_id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
      if (document.team_id !== null) {
        expect(document.team_id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
      }
      if (document.document_type) {
        expect(document.document_type.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
      }
    });
  });
}
