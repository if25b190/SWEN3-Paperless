meta {
  name: Create user
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  bru.setVar("createdUserId", "");
  bru.setVar("createdPassword", "BrunoPass123!");
}

body:json {
  {
    "username": "{{createdUsername}}",
    "password": "{{createdPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("createdUserId", res.getBody().id);
  }
}

tests {
  test("public registration creates the second user", function() {
    expect(
      res.getStatus(),
      "Registration failed. If this is HTTP 409, bruno_member already exists: delete that account or reset the local database, then rerun this create request before continuing."
    ).to.equal(201);
    expect(res.getBody().id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    expect(res.getBody().password).to.be.undefined;
    expect(res.getBody().email).to.be.undefined;
  });
}
