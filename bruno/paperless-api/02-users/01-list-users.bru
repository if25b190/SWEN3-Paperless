meta {
  name: List users
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("admin can list users", function() {
    expect(res.getStatus()).to.equal(200);
    expect(JSON.stringify(res.getBody())).not.to.match(/"email"\s*:/i);
    res.getBody().items.forEach((user) => {
      expect(user.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    });
  });
}
