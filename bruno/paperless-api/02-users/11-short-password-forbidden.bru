meta {
  name: Registration rejects a short password
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "bruno_short_password",
    "password": "1234567"
  }
}

tests {
  test("raw password must contain at least eight characters", function() {
    expect(res.getStatus()).to.equal(400);
  });
}
