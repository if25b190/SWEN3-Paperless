meta {
  name: Update document type
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/document-types/{{documentTypeId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{updatedDocumentTypeName}}",
    "description": "Updated by the Bruno collection"
  }
}

tests {
  test("updates the document type", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    expect(res.getBody().id).to.equal(bru.getVar("documentTypeId"));
  });
}
