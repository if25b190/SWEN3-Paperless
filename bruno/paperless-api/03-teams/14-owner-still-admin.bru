meta {
  name: Confirm owner remains ADMIN
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/teams/{{teamId}}/members
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("owner remains listed as ADMIN after rejected demotion and removal", function() {
    expect(res.getStatus()).to.equal(200);
    const members = res.getBody().items;
    members.forEach((member) => {
      expect(member.user.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    });
    const owner = members.find((member) => member.user.id === bru.getVar("userId"));
    expect(owner).to.exist;
    expect(owner.role).to.equal("ADMIN");
  });
}
