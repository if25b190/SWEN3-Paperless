meta {
  name: Reject blank team name
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/teams
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "   "
  }
}

tests {
  test("whitespace-only team names are rejected", function() {
    expect(res.getStatus()).to.equal(400);
  });
}
