meta {
  name: Create unrelated administrator team
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/teams
  body: json
  auth: bearer
}

auth:bearer {
  token: {{memberAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{unrelatedTeamName}}",
    "description": "Created to demonstrate team-scoped administration"
  }
}

script:pre-request {
  bru.setVar("unrelatedTeamId", "");
  bru.setVar("unrelatedTeamName", `BrunoUnrelatedTeam${Date.now()}`);
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("unrelatedTeamId", res.getBody().id);
  }
}

tests {
  test("READ_WRITE member can create an unrelated team", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    expect(res.getBody().owner_id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
    expect(res.getBody().owner_id).to.equal(bru.getVar("createdUserId"));
  });
}
