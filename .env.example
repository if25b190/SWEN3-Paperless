# ==============================================================================
# Environment Configuration Template for SWEN3-Paperless (.env.example)
# Copy to .env.local and adjust as needed: cp .env.example .env.local
# ==============================================================================

# Application Ports
BACKEND_PORT=8080
UI_PORT=3000
POSTGRES_PORT=5432

# Maximum size for an uploaded file and the full multipart request
MAX_UPLOAD_SIZE=50MB

# PostgreSQL Database Configuration
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=paperless_secure_password

# Spring Backend Datasource & Service Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/paperless
SPRING_DATASOURCE_USERNAME=paperless
SPRING_DATASOURCE_PASSWORD=paperless_secure_password

# Next.js UI Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=paperless
RABBITMQ_PASS=paperless_secure_password

# Backend outbox dispatcher
OCR_DISPATCH_ENABLED=true
OCR_DISPATCH_DELAY=1000

# RustFS object storage (the native backend uses S3_ENDPOINT; Compose overrides it)
DOCUMENT_STORAGE_TYPE=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=paperless-documents
RUSTFS_ACCESS_KEY=paperless
RUSTFS_SECRET_KEY=paperless_secure_password
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
# Set true for one startup to import the existing document-files volume, then reset.
MIGRATE_LEGACY_DOCUMENTS=false

# Standalone OCR worker (Tesseract language data for English and German is installed)
OCR_LANGUAGES=eng+deu
OCR_MAX_ATTEMPTS=3
OCR_RETRY_DELAY_MS=10000
OCR_PAGE_TIMEOUT=60
OCR_MAX_PAGES=100
